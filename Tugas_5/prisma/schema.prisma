datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

model User {
  id           String      @id @default(uuid())
  nama         String
  email        String      @unique
  passwordHash String
  role         String      @default("USER")
  kota         String?
  avatar       String?
  kuliner      Kuliner[]   @relation("UserKuliner")
  favorites    Favorite[]
  reviews      Review[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Kuliner {
  id            String       @id @default(uuid())
  nama          String
  deskripsi     String
  kategori      String
  daerah        String
  bahan         String[]
  rasa          String[]
  gambar        String?
  hargaMin      Int
  hargaMax      Int
  status        String       @default("PENDING")
  catatanAdmin  String?
  submittedBy   String?
  user          User?        @relation("UserKuliner", fields: [submittedBy], references: [id], onDelete: SetNull)
  favorites     Favorite[]
  reviews       Review[]
  mapPin        MapPin?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([kategori])
  @@index([daerah])
}

model Favorite {
  userId    String
  kulinerId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kuliner   Kuliner  @relation(fields: [kulinerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, kulinerId])
  @@index([kulinerId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String?
  namaUser  String
  kulinerId String
  rating    Int
  komentar  String
  status    String   @default("TAMPIL")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kuliner   Kuliner  @relation(fields: [kulinerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([kulinerId])
  @@index([status])
}

model FAQ {
  id         String   @id @default(uuid())
  pertanyaan String
  jawaban    String
  urutan     Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SiteMetadata {
  id    String @id @default(uuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

model MapPin {
  id        String   @id @default(uuid())
  kulinerId String   @unique
  kuliner   Kuliner  @relation(fields: [kulinerId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
}